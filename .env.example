# AI Job Hunter Agent - Environment Variables
# Copy to .env and fill in values

OPENAI_API_KEY=sk-...

# Optional overrides
# DEBUG=false
# APPLICATION_HEADLESS=true   # Set false for visible browser (debugging)
# DATABASE_PATH=data/job_hunter.db
# CHROMA_PERSIST_DIRECTORY=data/chroma_db
# EMBEDDING_PROVIDER=openai  # or huggingface
# EMBEDDING_MODEL=text-embedding-3-large
# HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# LLM_MODEL=gpt-4o-mini
